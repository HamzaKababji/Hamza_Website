{
  "responseOverrides": {
    "404": { "rewrite": "/404.html", "statusCode": 404 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [
    { "route": "/_astro/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } }
  ],
  "mimeTypes": {
    "avif": "image/avif",
    "webp": "image/webp",
    "toml": "text/plain"
  }
}
