---
const { overlay = false } = Astro.props as { overlay?: boolean };
const here = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class:list={['site-header', 'wrap', { overlay }]}>
  <a class="plate" href="/" aria-current={here === '/' ? 'page' : undefined}>HAMZA E<span class="visually-hidden">, Hamza Elkababji, home</span></a>
  <a class="work" href="/work" aria-current={here === '/work' ? 'page' : undefined}>Work</a>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 20px;
  }
  .overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
  }
  /* Work sits on its own, as a pill that stays readable over the hero photo. */
  .work {
    font: 700 13px/1 var(--font-body);
    font-stretch: 80%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--decal);
    background: rgba(10, 21, 15, 0.78);
    border: 1px solid var(--moss);
    border-radius: 999px;
    padding: 11px 18px;
  }
  .work:hover {
    border-color: var(--yellow);
  }
  .work[aria-current='page'] {
    border-color: var(--yellow);
    color: var(--yellow);
  }
</style>
