<script define:vars={{ EMBED }}>
  (() => {
    const g = document.getElementById("garageBox");
    const door = document.getElementById('gxDoor');
    const close = document.getElementById('gxClose');
    const inside = document.getElementById('gxInside');

    function setOpen(open) {
      g.dataset.open = String(open);
      door.setAttribute('aria-expanded', String(open));
      close.hidden = !open;
      if (open) {
        inside.removeAttribute('inert');
        door.setAttribute('tabindex', '-1');
        setTimeout(() => close.focus({ preventScroll: true }), 60);
      } else {
        inside.setAttribute('inert', '');
        door.removeAttribute('tabindex');
        door.focus({ preventScroll: true });
      }
    }
    door.addEventListener('click', () => setOpen(true));
    close.addEventListener('click', () => setOpen(false));

    // Bay 04: lift the cover, then load the Sketchfab embed (only now, never before).
    const bay = document.getElementById('bay');
    const box = document.getElementById('carBox');
    const btn = document.getElementById('uncover');
    const credit = document.getElementById('credit');
    btn.addEventListener('click', () => {
      const bare = bay.dataset.bare !== 'true';
      bay.dataset.bare = String(bare);
      btn.setAttribute('aria-pressed', String(bare));
      btn.textContent = bare ? 'Put the cover back' : 'Lift the cover';
      credit.hidden = !bare;
      const existing = box.querySelector('iframe');
      if (bare && !existing) {
        const f = document.createElement('iframe');
        f.src = EMBED;
        f.title = 'Audi Quattro S1, interactive 3D model by TonyWony on Sketchfab';
        f.allow = 'autoplay; fullscreen; xr-spatial-tracking';
        f.setAttribute('allowfullscreen', '');
        f.loading = 'lazy';
        box.appendChild(f);
      } else if (!bare && existing) {
        existing.remove();
      }
    });
  })();
</script>

