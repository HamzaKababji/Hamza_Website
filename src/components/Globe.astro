---
// Places: the scroll-driven globe. Cities with photos are rings you can click;
// that filters the gallery below (see Gallery.astro) and scrolls to it.
import { stops, places, routeKm } from '../lib/content';
import { allPhotos, slug } from '../lib/photos';
import worldUrl from 'world-atlas/countries-110m.json?url';

const cityCount = (city: string) => allPhotos.filter((p) => p.city === city).length;
const photoHref = (s: { id: string; city: string }) => `/?country=${s.id}&city=${slug(s.city)}#photos`;

const route = stops.map((s) => ({ ...s, photos: cityCount(s.city), href: photoHref(s) }));
const extras = places.map((s) => ({ ...s, photos: cityCount(s.city), href: photoHref(s) }));
const km = Math.round(routeKm);
---
<section class="places" id="places" aria-labelledby="places-h">
  <header class="wrap p-head">
    <h2 id="places-h" class="sec-title">Places</h2>
    <p class="intro">
      Born in Amman, then Dammam, Bahrain and London, Ontario. Everything after that is trips. Scroll and the car drives
      them in order.
    </p>
    <p class="howto"><span class="key" aria-hidden="true"></span>Cities with a yellow ring have photos. Click one to see them.</p>
  </header>

  <div class="tour" id="tour" style={`--stops:${stops.length}`}>
    <div class="pin">
      <div class="globe">
        <svg id="globe" viewBox="0 0 600 600" preserveAspectRatio="xMidYMid meet" role="img" aria-labelledby="globe-title">
          <title id="globe-title">Globe showing my route between {stops.length} stops, {km.toLocaleString('en-CA')} km in total</title>
          <defs><clipPath id="lens"><circle cx="300" cy="300" r="286"></circle></clipPath></defs>
          <circle class="ocean" cx="300" cy="300" r="286"></circle>
          <g clip-path="url(#lens)">
            <circle class="ocean2" id="gOcean" cx="300" cy="300" r="286"></circle>
            <path class="grat" id="gGrat"></path>
            <g id="gLand"></g>
            <path class="todo" id="gTodo"></path>
            <path class="done" id="gDone"></path>
            <g id="gCities"></g>
          </g>
          <circle class="rim" cx="300" cy="300" r="286"></circle>
          <g id="car" transform="translate(300 300)" aria-hidden="true">
            <ellipse cx="0" cy="3" rx="22" ry="11" fill="#000" opacity=".35"></ellipse>
            <g id="carBody">
              <rect x="-15" y="-12" width="8" height="4" rx="1.2" fill="#0a150f"></rect>
              <rect x="8" y="-12" width="8" height="4" rx="1.2" fill="#0a150f"></rect>
              <rect x="-15" y="8" width="8" height="4" rx="1.2" fill="#0a150f"></rect>
              <rect x="8" y="8" width="8" height="4" rx="1.2" fill="#0a150f"></rect>
              <path d="M-19 -6 Q-19 -9.5 -15 -9.5 L13 -9.5 Q19 -9 19.5 -4 L19.5 4 Q19 9 13 9.5 L-15 9.5 Q-19 9.5 -19 6 Z" fill="#1d3a29" stroke="#ecebe0" stroke-width="1.3"></path>
              <rect x="-19" y="-1.6" width="38.5" height="3.2" fill="#e3b520"></rect>
              <path d="M3.5 -7 L9 -6 Q10.5 0 9 6 L3.5 7 Z" fill="#a5a99b" opacity=".9"></path>
              <rect x="-13" y="-6.5" width="4.5" height="13" rx="1.5" fill="#a5a99b" opacity=".6"></rect>
              <rect x="-21" y="-8" width="2.6" height="16" rx="1" fill="#0a150f" stroke="#ecebe0" stroke-width=".8"></rect>
              <rect x="16.6" y="-7" width="2.2" height="3.4" rx="1" fill="#ecebe0"></rect>
              <rect x="16.6" y="3.6" width="2.2" height="3.4" rx="1" fill="#ecebe0"></rect>
            </g>
          </g>
        </svg>
        <div class="odo">
          <span class="spec">Odometer</span>
          <b id="odo">0 km</b>
          <span id="zoomLbl" class="zl" aria-hidden="true"></span>
        </div>
        <a class="skip-in" href="#photos" id="skipTour">Skip the drive</a>

        <!-- Pops up beside the globe when the car parks at a key place or one with photos,
             joined to the city by a leader line. -->
        <svg class="leader" id="leader" aria-hidden="true" data-show="false"><line id="leaderLine"></line><circle id="leaderDot" r="3.5"></circle></svg>
        <div class="callout" id="callout" aria-live="polite" data-show="false">
          <span class="spec" id="coLabel"></span>
          <b id="coCity"></b>
          <span class="co-text" id="coText"></span>
          <a class="see" id="coLink" href="#photos" data-photos hidden>See the photos <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </div>

  <!-- The route as text: read by screen readers, and shown under the still globe for reduced motion. -->
  <ol class="route-list wrap" aria-label="The route, in order">
    {route.map((s, i) => (
      <li>
        <b>{String(i + 1).padStart(2, '0')}</b> {s.city}, {s.country}{s.callout_text ? `: ${s.callout_text}` : s.note ? `, ${s.note}` : ''}
        {s.photos > 0 && <span class="rl-n"> · {s.photos} photos</span>}
      </li>
    ))}
  </ol>

  <script type="application/json" id="route-data" set:html={JSON.stringify({ route, extras, worldUrl })} />
</section>

<script>
  import { geoOrthographic, geoPath, geoInterpolate, geoDistance, geoGraticule10 } from 'd3-geo';
  import { feature } from 'topojson-client';

  type S = {
    id: string; city: string; country: string; iso?: string; lon: number; lat: number; note?: string;
    photos: number; href: string; callout?: string; callout_text?: string;
  };
  const { route, extras, worldUrl } = JSON.parse(document.getElementById('route-data')!.textContent!) as {
    route: S[];
    extras: S[];
    worldUrl: string;
  };

  const NS = 'http://www.w3.org/2000/svg';
  const R = 286;
  const C = 300;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const tour = document.getElementById('tour')!;
  const $ = (id: string) => document.getElementById(id)!;
  const globeBox = document.querySelector<HTMLElement>('#places .globe')!;
  const svg = $('globe');
  const co = $('callout');
  const narrow = matchMedia('(max-width: 760px)');
  const slug = (s: string) =>
    s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

  /* ---------- clicking into the photos ---------- */
  function showPhotos(country: string, city: string) {
    document.dispatchEvent(new CustomEvent('gallery:show', { detail: { country, city } }));
  }
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLElement>('[data-photos]');
    if (!a || !a.closest('#places')) return;
    const country = a.dataset.country || a.getAttribute('data-country');
    if (!country) return; // "Skip" style links just scroll
    e.preventDefault();
    showPhotos(country, a.dataset.city || '');
  });

  /* ---------- geometry ---------- */
  const ll = (s: S): [number, number] => [s.lon, s.lat];
  const proj = geoOrthographic().scale(R).translate([C, C]).clipAngle(90).precision(0.6);
  const path = geoPath(proj);
  const N = route.length - 1;
  const segs: ((u: number) => [number, number])[] = [];
  const cum = [0];
  for (let i = 0; i < N; i++) {
    segs.push(geoInterpolate(ll(route[i]), ll(route[i + 1])));
    cum.push(cum[i] + geoDistance(ll(route[i]), ll(route[i + 1])) * 6371);
  }
  // Zoom per stop: clamp(2600 / km to the nearest other stop, 1, 4.2)
  const ZS = route.map((st, i) => {
    let d = 1e9;
    route.forEach((o, j) => {
      if (j === i) return;
      const k = geoDistance(ll(st), ll(o)) * 6371;
      if (k > 5) d = Math.min(d, k);
    });
    return Math.max(1, Math.min(4.2, 2600 / d));
  });
  const grat = geoGraticule10();

  /* ---------- city dots: only cities with photos are links ---------- */
  const ALL = [...route, ...extras];
  const cityG = $('gCities');
  const cities = ALL.map((d, i) => {
    const has = d.photos > 0;
    const el = document.createElementNS(NS, has ? 'a' : 'g') as SVGElement;
    el.setAttribute('class', 'city' + (i >= route.length ? ' extra' : '') + (has ? ' has' : ''));
    if (has) {
      el.setAttribute('href', d.href);
      el.setAttribute('data-photos', '');
      el.setAttribute('data-country', d.id);
      el.setAttribute('data-city', slug(d.city));
      el.setAttribute('aria-label', `${d.city}: see ${d.photos} photos`);
      const ring = document.createElementNS(NS, 'circle');
      ring.setAttribute('class', 'ring');
      ring.setAttribute('r', '10');
      el.appendChild(ring);
    }
    const c = document.createElementNS(NS, 'circle');
    c.setAttribute('class', 'dot');
    c.setAttribute('r', i >= route.length ? '3.5' : '5.5');
    const t = document.createElementNS(NS, 'text');
    t.textContent = d.city;
    if (has) {
      const n = document.createElementNS(NS, 'tspan');
      n.setAttribute('class', 'n');
      n.textContent = ` ${d.photos}`;
      t.appendChild(n);
    }
    el.append(c, t);
    cityG.appendChild(el);
    return { el, text: t, d, i, label: d.city + (has ? ` ${d.photos}` : '') };
  });

  function line(fn: (u: number) => [number, number], u0: number, u1: number) {
    const pts = [];
    const k = 24;
    for (let j = 0; j <= k; j++) pts.push(fn(u0 + ((u1 - u0) * j) / k));
    return pts;
  }
  const ease = (x: number) => (x < 0.5 ? 2 * x * x : 1 - Math.pow(-2 * x + 2, 2) / 2);

  /** Page scroll as 0..1 through the tour. */
  function scrollTarget() {
    const r = tour.getBoundingClientRect();
    const span = Math.max(1, r.height - innerHeight);
    return Math.min(1, Math.max(0, -r.top / span));
  }
  /** Progress -> segment s, eased u (the car waits for the first and last 20%), current stop. */
  function stateAt(p: number) {
    const t = p * N;
    const s = Math.min(N - 1, Math.floor(t));
    const loc = t - s;
    const u = ease(Math.min(1, Math.max(0, (loc - 0.2) / 0.6)));
    return { s, u, stop: loc < 0.5 ? s : s + 1, parked: loc < 0.2 || loc > 0.8 };
  }

  let landSel: SVGPathElement[] = [];
  let heading = 0;
  let lastStop = -1;
  let staticStop = route.length - 1;
  let shown = -1; // displayed progress; eases toward the scroll position

  /* ---------- callouts: key places, and places with photos ---------- */
  const hasCallout = (s: S) => Boolean(s.callout || s.photos);
  function fillCallout(i: number) {
    const s = route[i];
    co.classList.toggle('is-key', Boolean(s.callout));
    $('coLabel').textContent = s.callout ?? `${s.photos} ${s.photos === 1 ? 'photo' : 'photos'}`;
    $('coCity').textContent = s.city;
    $('coText').textContent = s.callout_text ?? (s.note || s.country);
    const link = $('coLink') as HTMLAnchorElement;
    link.hidden = !s.photos;
    link.href = s.href;
    link.dataset.country = s.id;
    link.dataset.city = slug(s.city);
    link.firstChild!.textContent = s.callout && s.photos ? `See the ${s.photos} photos ` : 'See the photos ';
  }
  /** Put the card in the open space beside the globe (city's side first) with a leader line to the city.
   *  Without room beside the globe, it sits next to the city; on phones CSS docks it underneath. */
  const leader = $('leader');
  const leaderLine = $('leaderLine');
  const leaderDot = $('leaderDot');
  function placeCallout(xy: [number, number] | null) {
    if (narrow.matches || !xy) {
      co.style.transform = '';
      leader.dataset.show = 'false';
      return;
    }
    const g = globeBox.getBoundingClientRect();
    const r = svg.getBoundingClientRect();
    const size = Math.min(r.width, r.height); // the 600x600 viewBox is letterboxed inside the svg
    const ox = r.left - g.left + (r.width - size) / 2;
    const oy = r.top - g.top + (r.height - size) / 2;
    const k = size / 600;
    const x = ox + xy[0] * k;
    const y = oy + xy[1] * k;
    const cx = ox + C * k;
    const rad = R * k;
    const w = co.offsetWidth;
    const h = co.offsetHeight;
    const gap = 28;
    const roomRight = g.width - (cx + rad) >= w + gap;
    const roomLeft = cx - rad >= w + gap;
    const preferRight = xy[0] >= C;
    let left: number;
    let edgeX: number;
    if ((preferRight && roomRight) || (!roomLeft && roomRight)) {
      left = cx + rad + gap;
      edgeX = left;
    } else if (roomLeft) {
      left = cx - rad - gap - w;
      edgeX = left + w;
    } else {
      left = Math.max(8, Math.min(g.width - w - 8, xy[0] <= C ? x + 34 : x - 34 - w));
      edgeX = xy[0] <= C ? left : left + w;
    }
    const top = Math.max(56, Math.min(g.height - h - 64, y - h / 2));
    co.style.transform = `translate(${left.toFixed(0)}px, ${top.toFixed(0)}px)`;
    const edgeY = Math.max(top + 14, Math.min(top + h - 14, y));
    leaderLine.setAttribute('x1', x.toFixed(1));
    leaderLine.setAttribute('y1', y.toFixed(1));
    leaderLine.setAttribute('x2', edgeX.toFixed(1));
    leaderLine.setAttribute('y2', edgeY.toFixed(1));
    leaderDot.setAttribute('cx', edgeX.toFixed(1));
    leaderDot.setAttribute('cy', edgeY.toFixed(1));
    leader.dataset.show = 'true';
  }

  function draw() {
    raf = 0;
    const isStatic = reduce.matches;
    let st: { s: number; u: number; stop: number; parked: boolean };
    let pos: [number, number];
    let z: number;
    if (isStatic) {
      // Reduced motion: zoomed out, full route, no animation. Selecting a stop jumps to it.
      st = { s: N - 1, u: 1, stop: staticStop, parked: false };
      pos = staticStop === route.length - 1 ? [-36, 38] : ll(route[staticStop]);
      z = 1;
      proj.scale(R).rotate([-pos[0], -pos[1]]);
    } else {
      const target = scrollTarget();
      shown = shown < 0 ? target : shown + (target - shown) * 0.16;
      if (Math.abs(target - shown) < 0.00004) shown = target;
      else req(); // keep easing until we catch up
      st = stateAt(shown);
      pos = segs[st.s](st.u);
      const L = cum[st.s + 1] - cum[st.s];
      z = ZS[st.s] + (ZS[st.s + 1] - ZS[st.s]) * st.u;
      if (L > 2500) z = z + (1 - z) * Math.sin(Math.PI * st.u); // zoom out mid-flight on long legs
      // Tilt the latitude more as we zoom, so Europe sits in the middle of the lens.
      proj.scale(R * z).rotate([-pos[0], -pos[1] * (0.75 + 0.25 * Math.min(1, (z - 1) / 1.5))]);
    }
    $('gOcean').setAttribute('r', String(R * z));
    $('zoomLbl').textContent = z > 1.4 ? `Zoomed in ${z.toFixed(1)}×` : '';
    $('gGrat').setAttribute('d', path(grat) ?? '');
    for (const el of landSel) el.setAttribute('d', path((el as any).__d) ?? '');

    const done: [number, number][][] = [];
    const todo: [number, number][][] = [];
    if (isStatic) {
      for (let i = 0; i < N; i++) done.push(line(segs[i], 0, 1));
    } else {
      for (let i = 0; i < st.s; i++) done.push(line(segs[i], 0, 1));
      done.push(line(segs[st.s], 0, Math.max(0.0001, st.u)));
      todo.push(line(segs[st.s], st.u, 1));
      for (let j = st.s + 1; j < N; j++) todo.push(line(segs[j], 0, 1));
    }
    $('gDone').setAttribute('d', path({ type: 'MultiLineString', coordinates: done } as any) ?? '');
    $('gTodo').setAttribute('d', path({ type: 'MultiLineString', coordinates: todo } as any) ?? '');

    // Labels: the current stop wins, then cities with photos, then the nearest; outside the lens is hidden.
    const centre = proj.invert!([C, C])!;
    const rank = (i: number) => (i === st.stop ? -1000 : (ALL[i].photos ? 0 : 500) + Math.abs(i - st.stop));
    const order = ALL.map((_, i) => i).sort((a, b) => rank(a) - rank(b));
    const placed: number[][] = [];
    const labelled = new Set<number>();
    const seenLabel = new Set<string>();
    for (const i of order) {
      const d = ALL[i];
      const xy = proj(ll(d))!;
      if (geoDistance(ll(d), centre) > 1.5 || Math.hypot(xy[0] - C, xy[1] - C) > R - 6) continue;
      if (seenLabel.has(d.city)) continue; // Amman and London, Ontario appear twice
      const w = cities[i].label.length * 6.6 + 14;
      const above = i === st.stop && !isStatic;
      const box = above ? [xy[0] - w / 2, xy[1] - 36, xy[0] + w / 2, xy[1] - 16] : [xy[0] + 10, xy[1] - 9, xy[0] + 10 + w, xy[1] + 7];
      const hit = placed.some((b) => !(box[2] < b[0] || box[0] > b[2] || box[3] < b[1] || box[1] > b[3]));
      if (!hit) {
        placed.push(box);
        labelled.add(i);
        seenLabel.add(d.city);
      }
    }
    for (const c of cities) {
      const xy = proj(ll(c.d))!;
      const vis = geoDistance(ll(c.d), centre) < 1.5 && Math.hypot(xy[0] - C, xy[1] - C) < R - 2;
      c.el.style.display = vis ? '' : 'none';
      c.el.setAttribute('transform', `translate(${xy[0].toFixed(1)},${xy[1].toFixed(1)})`);
      c.el.classList.toggle('seen', c.i < route.length && (isStatic || c.i <= st.stop));
      c.el.classList.toggle('current', c.i === st.stop && !isStatic);
      c.text.style.display = labelled.has(c.i) ? '' : 'none';
      const above = c.i === st.stop && !isStatic;
      c.text.setAttribute('x', above ? '0' : '12');
      c.text.setAttribute('y', above ? '-22' : '4');
      c.text.setAttribute('text-anchor', above ? 'middle' : 'start');
    }

    // Car: sits on the route and turns to face its direction of travel.
    const car = $('car');
    car.style.display = isStatic ? 'none' : '';
    if (!isStatic) {
      const here = proj(pos);
      const ahead = proj(segs[st.s](Math.min(1, st.u + 0.02)));
      if (ahead && here && Math.hypot(ahead[0] - here[0], ahead[1] - here[1]) > 0.5)
        heading = (Math.atan2(ahead[1] - here[1], ahead[0] - here[0]) * 180) / Math.PI;
      $('carBody').setAttribute('transform', `rotate(${heading.toFixed(1)})`);
      if (here) car.setAttribute('transform', `translate(${here[0].toFixed(1)} ${here[1].toFixed(1)})`);
    }

    const km = isStatic ? cum[N] : cum[st.s] + (cum[st.s + 1] - cum[st.s]) * st.u;
    $('odo').textContent = `${Math.round(km).toLocaleString('en-CA')} km`;

    if (st.stop !== lastStop) {
      lastStop = st.stop;
      fillCallout(st.stop);
    }
    const show = !isStatic && st.parked && hasCallout(route[st.stop]);
    if (co.dataset.show !== String(show)) {
      co.dataset.show = String(show);
      co.inert = !show;
    }
    if (show) placeCallout(proj(ll(route[st.stop])));
    else leader.dataset.show = 'false';
  }

  let raf = 0;
  function req() {
    if (!raf) raf = requestAnimationFrame(draw);
  }

  $('skipTour').addEventListener('click', (e) => {
    e.preventDefault();
    showPhotos('all', '');
  });

  function setMode() {
    document.documentElement.classList.toggle('globe-static', reduce.matches);
    lastStop = -1;
    req();
  }
  reduce.addEventListener('change', setMode);
  addEventListener('scroll', req, { passive: true });
  addEventListener('resize', req);
  setMode();

  fetch(worldUrl)
    .then((r) => r.json())
    .then((world) => {
      const visited = new Set(route.map((s) => s.iso).filter(Boolean));
      const feats = (feature(world, world.objects.countries) as any).features;
      const g = $('gLand');
      landSel = feats.map((f: any) => {
        const p = document.createElementNS(NS, 'path');
        p.setAttribute('class', 'land' + (visited.has(f.id) ? ' v' : ''));
        (p as any).__d = f;
        g.appendChild(p);
        return p;
      });
      req();
    })
    .catch(() => {});
</script>

<style>
  .p-head {
    display: grid;
    gap: 12px;
    padding-block: clamp(56px, 9vw, 112px) 28px;
  }
  .intro {
    max-width: 56ch;
    color: var(--mist);
    font-size: 17px;
  }
  .howto {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font: 600 14px/1.3 var(--font-body);
    font-stretch: 80%;
    letter-spacing: 0.04em;
    color: var(--yellow);
  }
  .key {
    flex: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid var(--yellow);
    box-shadow: inset 0 0 0 3px var(--night), inset 0 0 0 8px var(--yellow);
  }

  .tour {
    position: relative;
    height: calc(var(--stops) * 70vh);
    background: var(--deep);
    border-block: 1px solid var(--line);
  }
  :global(.globe-static) .tour {
    height: auto;
  }
  .pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    max-width: var(--max);
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    padding: clamp(16px, 3vw, 32px) var(--gutter);
    overflow: hidden;
  }
  :global(.globe-static) .pin {
    position: static;
    height: auto;
    min-height: 640px;
  }
  .globe {
    position: relative;
    min-width: 0;
    min-height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .globe svg {
    width: 100%;
    height: 100%;
    max-height: 100%;
    touch-action: pan-y;
  }
  .globe :global(.ocean),
  .globe :global(.ocean2) {
    fill: var(--ocean);
  }
  .globe :global(.rim) {
    fill: none;
    stroke: var(--moss);
    stroke-width: 1.5;
  }
  .globe :global(.grat) {
    fill: none;
    stroke: var(--grat);
    stroke-width: 0.6;
  }
  .globe :global(.land) {
    fill: var(--green);
    stroke: var(--deep);
    stroke-width: 0.5;
  }
  .globe :global(.land.v) {
    fill: var(--moss);
  }
  .globe :global(.done) {
    fill: none;
    stroke: var(--yellow);
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .globe :global(.todo) {
    fill: none;
    stroke: var(--stone);
    stroke-width: 1.4;
    stroke-dasharray: 2 6;
    stroke-linecap: round;
