---
import { CONTACT } from '../lib/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap inner">
    <div class="stripes" aria-hidden="true"><i></i><i></i></div>
    <ul>
      <li><a class="link" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></li>
      <li><a class="link" href={CONTACT.linkedin} rel="me">LinkedIn</a></li>
      <li><a class="link" href={CONTACT.github} rel="me">GitHub</a></li>
    </ul>
    <p class="spec">© {year} Hamza Elkababji · London, Ontario</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(64px, 10vw, 120px);
    padding-block: 32px 40px;
    border-top: 1px solid var(--rule);
  }
  .inner {
    display: grid;
    gap: 18px;
  }
  .stripes {
    width: 120px;
  }
  .stripes :global(i) {
    height: 3px;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 15px;
  }
  :global(.theme-decal) .link {
    color: var(--green);
  }
  @media (min-width: 720px) {
    .inner {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 32px;
    }
  }
</style>
