---
// Home is the whole site in one scroll: hero, the globe, the photos it leads to, the garage.
// Work is its own page; Now slides out from the left on every page.
import Base from '../layouts/Base.astro';
import Globe from '../components/Globe.astro';
import Gallery from '../components/Gallery.astro';
import Garage from '../components/Garage.astro';
import { site } from '../lib/content';
import { hero } from '../lib/hero';

const { specs } = site;
const specRows = [
  ['Based in', specs.based_in],
  ['Studying', specs.studying],
  ['Building', specs.building],
  ['Shooting', specs.shooting],
];
---
<Base overlayHeader>
  <section class="hero" aria-labelledby="name">
    <picture class="hero-img">
      <source media="(max-width: 719px)" type="image/avif" srcset={hero.mobile.avif} sizes="100vw" width={hero.mobile.width} height={hero.mobile.height} />
      <source media="(max-width: 719px)" type="image/webp" srcset={hero.mobile.webp} sizes="100vw" width={hero.mobile.width} height={hero.mobile.height} />
      <source type="image/avif" srcset={hero.desktop.avif} sizes="60vw" />
      <source type="image/webp" srcset={hero.desktop.webp} sizes="60vw" />
      <img
        src={hero.desktop.fallback}
        alt={site.hero.alt}
        width={hero.desktop.width}
        height={hero.desktop.height}
        fetchpriority="high"
        decoding="async"
        style={`--focus:${site.hero.focus};--mfocus:${site.hero.mobile_focus}`}
      />
    </picture>

    <div class="hero-text wrap">
      <div class="title">
        <h1 id="name" class="name">Hamza Elkababji</h1>
        <div class="reflect" aria-hidden="true" data-text="Hamza Elkababji"></div>
      </div>
      <div class="stripes" aria-hidden="true"><i></i><i></i></div>
      <dl class="specs">
        {specRows.map(([label, value]) => (
          <div>
            <dt class="spec">{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      <a class="cue" href="#places">Scroll to start the drive <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <Globe />
  <Gallery />
  <Garage />

  <section class="about wrap" aria-labelledby="about-h">
    <h2 id="about-h" class="spec">About</h2>
    <div class="about-copy">
      <p class="lede">
        I’m Hamza. I study Software Engineering at Western University in London, Ontario, and I just finished a sixteen-month
        co-op as a software controls engineer at Husky Technologies in Bolton.
      </p>
      <p>
        I co-founded WE AutoPilot, Western’s self-driving car club, and I lead its mapping and localization team. I was
        born in Amman, I built my first PC at 14, and lately most of my free time goes into a Fujifilm X-T2 with the 23mm
        lens at f/2. I like water, mountains and cars, especially old ones.
      </p>
      <p><a class="link" href="/work">My work and résumé →</a></p>
    </div>
  </section>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
  }
  .hero-img {
    position: absolute;
    inset: 0 0 auto 0;
    height: min(68vh, 600px);
    z-index: -1;
  }
  .hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--mfocus);
    -webkit-mask-image: linear-gradient(0deg, transparent 4%, #000 48%);
    mask-image: linear-gradient(0deg, transparent 4%, #000 48%);
  }
  .hero-text {
    position: relative;
    display: grid;
    gap: 22px;
    padding-top: calc(min(68vh, 600px) - 92px);
    padding-bottom: 24px;
  }
  .name,
  .reflect {
    font-family: var(--font-display);
    font-size: clamp(42px, 12.4vw, 136px);
    line-height: 0.95;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .name {
    color: var(--decal);
  }
  .reflect {
    transform: scaleY(-1);
    margin-top: -0.06em;
    height: 0.55em;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    color: var(--dusk);
    opacity: 0.3;
    filter: blur(1px);
    pointer-events: none;
    user-select: none;
    -webkit-mask-image: linear-gradient(0deg, #000, transparent 75%);
    mask-image: linear-gradient(0deg, #000, transparent 75%);
  }
  /* Drawn as generated content: it's decoration, not text to read or contrast-check. */
  .reflect::before {
    content: attr(data-text);
    display: block;
  }
  .hero .stripes {
    width: min(100%, 520px);
  }
  .specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 16px;
    margin: 0;
    max-width: 640px;
  }
  .specs dd {
    margin: 5px 0 0;
    font: 600 19px/1.15 var(--font-body);
    font-stretch: 75%;
    color: var(--decal);
  }
  .cue {
    justify-self: start;
    margin-top: 6px;
    font: 600 13px/1 var(--font-body);
    font-stretch: 80%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--yellow);
    padding: 10px 0;
  }
  .cue span {
    display: inline-block;
    margin-left: 6px;
    animation: nudge 2.2s ease-in-out infinite;
  }
  @keyframes nudge {
    50% { transform: translateY(3px); }
  }

  @media (min-width: 720px) {
    .hero {
      min-height: clamp(580px, 92vh, 900px);
      display: flex;
    }
    /* The photo stays on the right; the name and specs sit on plain green, never over it. */
    .hero-img {
      inset: 0 0 0 auto;
      width: 60%;
      height: auto;
    }
    .hero-img img {
      object-position: var(--focus);
      -webkit-mask-image: linear-gradient(90deg, transparent 18%, #000 48%), linear-gradient(0deg, transparent, #000 14%);
      mask-image: linear-gradient(90deg, transparent 18%, #000 48%), linear-gradient(0deg, transparent, #000 14%);
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
    }
    .hero-text {
      align-content: end;
      gap: 26px;
      padding-top: 120px;
      padding-bottom: clamp(32px, 6vh, 64px);
    }
    .title {
      margin-bottom: clamp(24px, 8vh, 96px);
    }
    .name,
    .reflect {
      font-size: clamp(60px, 7.4vw, 136px);
    }
    .hero .stripes {
      width: min(40vw, 580px);
    }
    .hero .stripes :global(i) {
      height: 6px;
    }
    .specs {
      grid-template-columns: repeat(4, max-content);
      gap: 18px clamp(24px, 3vw, 48px);
      max-width: none;
    }
    .specs dd {
      font-size: clamp(18px, 1.6vw, 23px);
    }
  }

  /* ---------- about ---------- */
  .about {
    display: grid;
    gap: 16px;
    padding-top: clamp(64px, 10vw, 128px);
  }
  .about-copy {
    display: grid;
    gap: 18px;
    max-width: 62ch;
    color: var(--mist);
    font-size: 17px;
  }
  .lede {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.2vw, 38px);
    line-height: 1.2;
    color: var(--decal);
  }
  @media (min-width: 900px) {
    .about {
      grid-template-columns: minmax(140px, 1fr) 3fr;
      gap: 40px;
    }
    .about h2 {
      padding-top: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cue span {
      animation: none;
    }
  }
</style>
