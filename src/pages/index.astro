---
import Base from '../layouts/Base.astro';
import { site, stops, routeKm } from '../lib/content';
import { hero } from '../lib/hero';
import { photoStats } from '../lib/photos';

const { specs } = site;
const specRows = [
  ['Based in', specs.based_in],
  ['Studying', specs.studying],
  ['Building', specs.building],
  ['Shooting', specs.shooting],
];

const cities = new Set(stops.map((s) => s.city)).size;
const km = Math.round(routeKm / 1000) * 1000;

const teasers = [
  {
    href: '/photos',
    title: 'Photos',
    text: 'Canals in Amsterdam, a yellow Beetle in Luxembourg, Toronto’s harbour at blue hour. A lot of it shot through a window, a mirror or a bike frame.',
    stat: photoStats.total ? `${photoStats.total} photos · ${photoStats.countries} countries` : 'X-T2 · 23mm f/2',
  },
  {
    href: '/places',
    title: 'Places',
    text: 'From Amman to Rattlesnake Point, by way of Dammam, Manama, Istanbul and Amsterdam. Scroll, and a small rally car drives the route.',
    stat: `${cities} cities · ${km.toLocaleString('en-CA')} km`,
  },
  {
    href: '/garage',
    title: 'Garage',
    text: 'The camera, the laptop, the first PC I built at 14, and a parking bay I’m keeping free for an Audi Sport Quattro S1.',
    stat: 'Open the door',
  },
  {
    href: '/now',
    title: 'Now',
    text: 'What I’m reading, playing, building and shooting this month. It’s also a config file, if you’d rather read it that way.',
    stat: 'now.toml',
  },
  {
    href: '/work',
    title: 'Work',
    text: 'My résumé, built into the site. Sixteen months at Husky, WE AutoPilot, and the projects that come with numbers.',
    stat: 'Résumé',
  },
];
---
<Base overlayHeader>
  <section class="hero" aria-labelledby="name">
    <picture class="hero-img">
      <source media="(max-width: 719px)" type="image/avif" srcset={hero.mobile.avif} sizes="100vw" width={hero.mobile.width} height={hero.mobile.height} />
      <source media="(max-width: 719px)" type="image/webp" srcset={hero.mobile.webp} sizes="100vw" width={hero.mobile.width} height={hero.mobile.height} />
      <source type="image/avif" srcset={hero.desktop.avif} sizes="70vw" />
      <source type="image/webp" srcset={hero.desktop.webp} sizes="70vw" />
      <img
        src={hero.desktop.fallback}
        alt={site.hero.alt}
        width={hero.desktop.width}
        height={hero.desktop.height}
        fetchpriority="high"
        decoding="async"
        style={`--focus:${site.hero.focus};--mfocus:${site.hero.mobile_focus}`}
      />
    </picture>

    <div class="hero-text wrap">
      <div class="title">
        <h1 id="name" class="name">Hamza Elkababji</h1>
        <div class="reflect" aria-hidden="true"><span>Hamza Elkababji</span></div>
      </div>
      <div class="stripes" aria-hidden="true"><i></i><i></i></div>
      <dl class="specs">
        {specRows.map(([label, value]) => (
          <div>
            <dt class="spec">{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="intro wrap" aria-labelledby="intro-h">
    <h2 id="intro-h" class="spec">Hello</h2>
    <div class="intro-copy">
      <p class="lede">
        I’m Hamza. I study Software Engineering at Western University in London, Ontario, and I just finished a sixteen-month
        co-op as a software controls engineer at Husky Technologies in Bolton.
      </p>
      <p>
        I co-founded WE AutoPilot, Western’s self-driving car club, and I lead its mapping and localization team. I was
        born in Amman, I built my first PC at 14, and lately most of my free time goes into a Fujifilm X-T2 with the 23mm
        lens at f/2. I like water, mountains, and old rally cars in British racing green.
      </p>
    </div>
  </section>

  <nav class="teasers wrap" aria-label="Sections">
    <ol>
      {teasers.map((t, i) => (
        <li>
          <a href={t.href}>
            <span class="no spec">{String(i + 1).padStart(2, '0')}</span>
            <span class="t-title">{t.title}</span>
            <span class="t-text">{t.text}</span>
            <span class="t-stat spec">{t.stat}<span class="arrow" aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
</Base>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
  }
  .hero-img {
    position: absolute;
    inset: 0 0 auto 0;
    height: min(68vh, 600px);
    z-index: -1;
  }
  .hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--mfocus);
    --fade-top: linear-gradient(180deg, transparent 0, #000 120px);
    -webkit-mask-image: var(--fade-top), linear-gradient(0deg, transparent 4%, #000 48%);
    mask-image: var(--fade-top), linear-gradient(0deg, transparent 4%, #000 48%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }
  .hero-text {
    position: relative;
    display: grid;
    gap: 22px;
    padding-top: calc(min(68vh, 600px) - 92px);
    padding-bottom: 24px;
  }
  .name,
  .reflect {
    font-family: var(--font-display);
    font-size: clamp(42px, 12.4vw, 150px);
    line-height: 0.95;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .name {
    color: var(--decal);
    text-shadow: 0 1px 24px rgba(12, 25, 18, 0.35);
  }
  .reflect {
    transform: scaleY(-1);
    margin-top: -0.06em;
    height: 0.55em;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    color: var(--dusk);
    opacity: 0.3;
    filter: blur(1px);
    pointer-events: none;
    user-select: none;
    -webkit-mask-image: linear-gradient(0deg, #000, transparent 75%);
    mask-image: linear-gradient(0deg, #000, transparent 75%);
  }
  .hero .stripes {
    width: min(100%, 520px);
  }
  .specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px 16px;
    margin: 0;
    max-width: 640px;
  }
  .specs dd {
    margin: 5px 0 0;
    font: 600 19px/1.15 var(--font-body);
    font-stretch: 75%;
    color: var(--decal);
  }

  @media (min-width: 720px) {
    .hero {
      min-height: clamp(580px, 92vh, 900px);
      display: flex;
    }
    .hero-img {
      inset: 0 0 0 auto;
      width: 70%;
      height: auto;
    }
    .hero-img img {
      object-position: var(--focus);
      -webkit-mask-image: var(--fade-top), linear-gradient(90deg, transparent, #000 40%), linear-gradient(0deg, transparent, #000 16%);
      mask-image: var(--fade-top), linear-gradient(90deg, transparent, #000 40%), linear-gradient(0deg, transparent, #000 16%);
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
    }
    .hero-text {
      align-content: end;
      gap: 26px;
      padding-top: 120px;
      padding-bottom: clamp(40px, 7vh, 72px);
    }
    .title {
      margin-bottom: clamp(24px, 9vh, 110px);
    }
    .name,
    .reflect {
      font-size: clamp(64px, 8.6vw, 150px);
    }
    .hero .stripes {
      width: min(44vw, 620px);
    }
    .hero .stripes :global(i) {
      height: 6px;
    }
    .specs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      max-width: min(56vw, 760px);
    }
    .specs dd {
      font-size: clamp(18px, 1.7vw, 24px);
    }
  }

  /* ---------- intro ---------- */
  .intro {
    display: grid;
    gap: 16px;
    padding-block: clamp(48px, 9vw, 112px) clamp(32px, 5vw, 56px);
  }
  .intro-copy {
    display: grid;
    gap: 18px;
    max-width: 62ch;
    color: var(--mist);
    font-size: 17px;
  }
  .lede {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.2vw, 38px);
    line-height: 1.2;
    color: var(--decal);
  }
  @media (min-width: 900px) {
    .intro {
      grid-template-columns: minmax(140px, 1fr) 3fr;
      gap: 40px;
    }
    .intro h2 {
      padding-top: 12px;
    }
  }

  /* ---------- teasers ---------- */
  .teasers ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .teasers a {
    display: grid;
    grid-template-columns: 36px 1fr;
    gap: 6px 12px;
    padding: 22px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: var(--mist);
  }
  .no {
    padding-top: 10px;
    color: var(--muted);
  }
  .t-title {
    font-family: var(--font-display);
    font-size: clamp(34px, 4.4vw, 54px);
    line-height: 1;
    color: var(--decal);
    transition: color 0.2s;
  }
  .t-text {
    grid-column: 2;
    max-width: 58ch;
    font-size: 15.5px;
  }
  .t-stat {
    grid-column: 2;
    display: inline-flex;
    gap: 10px;
    align-items: center;
    color: var(--stone);
  }
  .arrow {
    color: var(--yellow);
    font-size: 15px;
    transition: transform 0.2s;
  }
  .teasers a:hover .t-title,
  .teasers a:focus-visible .t-title {
    color: var(--yellow);
  }
  .teasers a:hover .arrow {
    transform: translateX(4px);
  }
  @media (min-width: 900px) {
    .teasers a {
      grid-template-columns: 56px minmax(180px, 1fr) 2fr minmax(180px, auto);
      align-items: baseline;
      gap: 24px;
      padding: 26px 4px;
    }
    .no,
    .t-text,
    .t-stat {
      grid-column: auto;
      padding-top: 0;
    }
    .t-stat {
      justify-self: end;
    }
  }
</style>
