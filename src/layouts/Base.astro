---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/instrument-serif/latin-400.css';
import '../styles/global.css';
import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import instrumentLatin from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import NowDrawer from '../components/NowDrawer.astro';
import { SITE_NAME, SITE_DESCRIPTION } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  theme?: 'night' | 'decal';
  ogImage?: string;
  overlayHeader?: boolean;
}

const { title, description = SITE_DESCRIPTION, theme = 'night', ogImage = '/og.jpg', overlayHeader = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE_NAME}` : SITE_NAME;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogUrl = new URL(ogImage, Astro.site);
---
<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={theme === 'decal' ? '#ecebe0' : '#0c1912'} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hamza Elkababji, standing at the edge of the escarpment at Rattlesnake Point" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={instrumentLatin} as="font" type="font/woff2" crossorigin />
    <slot name="head" />
  </head>
  <body class={theme === 'decal' ? 'theme-decal' : undefined}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <NowDrawer />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 16px;
    top: -100px;
    z-index: 100;
    background: var(--yellow);
    color: var(--night);
    padding: 10px 14px;
    border-radius: 4px;
    font: 600 14px/1 var(--font-body);
    text-decoration: none;
  }
  .skip-link:focus {
    top: 12px;
  }
  main:focus {
    outline: none;
  }
</style>
